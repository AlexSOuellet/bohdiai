{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bohdiai",
  // worker.ts wraps the OpenNext app (.open-next/worker.js) and adds the daily job.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bohdiai"
    }
  ],
  // Per-visitor allowance for every public form (estimate, contact, inquiry, ...).
  // Keyed by form + the visitor address Cloudflare sets; see lib/forms/rate-limit.ts.
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "images": { "binding": "IMAGES" },
  // Visitor numbers: one data point per page view, no cookies (lib/visits/page-view.ts).
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "bohdiai_visits" }],
  // Daily, early morning: save each Full site's finished months (worker.ts → /api/cron/visit-months).
  "triggers": { "crons": ["15 7 * * *"] },
  "observability": { "enabled": true }
}
