{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bohdiai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bohdiai"
    }
  ],
  // Per-visitor allowance for every public form (estimate, contact, waitlist, ...).
  // Keyed by form + the visitor address Cloudflare sets; see lib/forms/rate-limit.ts.
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
